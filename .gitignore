# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
.env

# IDE / workspace
.idea/
.vscode/
*.code-workspace

# Build artifacts
build/
dist/
release_assets/
*.egg-info/

# Runtime logs and generated files
*.log
logs/**
!logs/.gitkeep

# Настройки удалённого наблюдения: в них пароли и токен бота
**/config/remote_monitor.json
# Пользователи бота наблюдения: номера чатов и права
**/config/telegram_users.json
# Настройки связи с камерой у каждого рабочего места свои
**/config/climate_chamber.json
# Текущий сценарий прогона и состояние идущего прогона - рабочие файлы программы
**/config/climate_scenario_current.json
**/config/climate_run_state.json
# Платы камеры и история смены их адресов - у каждого рабочего места свои
**/config/chamber_boards.json
**/config/board_addressing.json
# cloudflared для туннеля сайта - сторонняя программа, кладётся рядом сама
tools/cloudflared*.exe
# Сценарии прогона, сохранённые на рабочем месте (готовый программа создаёт сама)
**/scenarios/

# OS files
Thumbs.db
.DS_Store
